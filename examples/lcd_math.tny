const TERM: *int = 0xFFFF;

fn add(a: int, b: int) -> int {
    return a + b;
}

fn add_5(a: int) -> int {
    return add(a, 5);
}

fn main() {
    let step_1 = add(0, 2);
    let step_2 = add_5(step_1);
    let step_3 = step_2 * 8 - 13 % 6 / 2 + 43;

    *TERM = step_3;
}

