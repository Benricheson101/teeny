program = { stmt } ;

stmt = var_decl
     | fn_decl
     | struct_decl
     | if_stmt
     | while_stmt
     | return_stmt
     | block
     | expr_stmt ;

block = "{" { stmt } "}" ;

var_decl = ("let" | "const") IDENTIFIER [ ":" type ] "=" expression ";" ;

fn_decl = "fn" IDENTIFIER "(" [ param_list ] ")" [ "->" type ] block ;

param_list = param { "," param } ;

param = "self"
      | IDENTIFIER ":" type ;

struct_decl = "struct" IDENTIFIER "{" { struct_member } "}" ;

struct_member = field_decl
              | fn_decl ;

field_decl = IDENTIFIER ":" type [ "," ] ;

if_stmt = "if" "(" expression ")" stmt [ "else" stmt ] ;

while_stmt = "while" "(" expression ")" stmt ;

return_stmt = "return" [ expression ] ";" ;

expr_stmt = expression ";" ;

(* expressions, listed in order of increasing precedence *)

expression = assignment ;

assignment = logical_or [ ("=" | "+=" | "-=" | "*=" | "/=" | "%=") expression ] ;

logical_or = logical_and { "||" logical_and } ;

logical_and = bit_or { "&&" bit_or } ;

bit_or = bit_xor { "|" bit_xor } ;

bit_xor = bit_and { "^" bit_and } ;

bit_and = equality { "&" equality } ;

equality = comparison { ("==" | "!=") comparison } ;

comparison = bit_shift { ("<" | "<=" | ">" | ">=") bit_shift } ;

bit_shift = sum { ("<<" | ">>") sum } ;

sum = product { ("+" | "-") product } ;

product = prefix { ("*" | "/" | "%") prefix } ;

prefix = ("-" | "!" | "*" | "&" | "++" | "--") prefix
       | postfix ;

postfix = primary { postfix_op } ;

postfix_op = "++"
           | "--"
           | "(" [ arg_list ] ")"
           | "[" expression "]"
           | "." IDENTIFIER
           | "::" IDENTIFIER
           | "{" struct_init_fields "}" ;

primary = INTEGER
        | "true"
        | "false"
        | IDENTIFIER
        | "(" expression ")"
        | "[" [ arg_list ] "]" ;

arg_list = expression { "," expression } ;

struct_init_fields = struct_init_field { "," struct_init_field } ;

struct_init_field = IDENTIFIER [ ":" expression ] ;

type = "int"
     | "bool"
     | IDENTIFIER
     | "*" type
     | "[" type ";" INTEGER "]" ;

(*
vim: ft=ebnf
*)
